{
  "name": "theokit",
  "version": "0.65.0",
  "description": "The TheoKit web framework — file-based routing, typed server surfaces, the Vite plugin, the CLI and the deploy adapters, around agents served from agents/*.ts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit.git",
    "directory": "packages/theo"
  },
  "homepage": "https://github.com/usetheokit/theokit/tree/main/packages/theo#readme",
  "bugs": {
    "url": "https://github.com/usetheokit/theokit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/check-pack-no-workspace.mjs ."
  },
  "bin": {
    "theokit": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./boot": {
      "types": "./dist/boot/index.d.ts",
      "import": "./dist/boot/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/agent": {
      "types": "./dist/server/agent/index.d.ts",
      "import": "./dist/server/agent/index.js"
    },
    "./server/auth": {
      "types": "./dist/server/auth/index.d.ts",
      "import": "./dist/server/auth/index.js"
    },
    "./server/cost": {
      "types": "./dist/server/cost/index.d.ts",
      "import": "./dist/server/cost/index.js"
    },
    "./server/cost/sqlite": {
      "types": "./dist/server/cost/sqlite/index.d.ts",
      "import": "./dist/server/cost/sqlite/index.js"
    },
    "./server/cron": {
      "types": "./dist/server/cron/index.d.ts",
      "import": "./dist/server/cron/index.js"
    },
    "./server/define": {
      "types": "./dist/server/define/index.d.ts",
      "import": "./dist/server/define/index.js"
    },
    "./server/http": {
      "types": "./dist/server/http/index.d.ts",
      "import": "./dist/server/http/index.js"
    },
    "./server/jobs": {
      "types": "./dist/server/jobs/index.d.ts",
      "import": "./dist/server/jobs/index.js"
    },
    "./server/observability": {
      "types": "./dist/server/observability/index.d.ts",
      "import": "./dist/server/observability/index.js"
    },
    "./server/plugins": {
      "types": "./dist/server/plugins/index.d.ts",
      "import": "./dist/server/plugins/index.js"
    },
    "./server/rate-limit": {
      "types": "./dist/server/rate-limit/index.d.ts",
      "import": "./dist/server/rate-limit/index.js"
    },
    "./server/realtime": {
      "types": "./dist/server/realtime/index.d.ts",
      "import": "./dist/server/realtime/index.js"
    },
    "./server/scan": {
      "types": "./dist/server/scan/index.d.ts",
      "import": "./dist/server/scan/index.js"
    },
    "./server/security": {
      "types": "./dist/server/security/index.d.ts",
      "import": "./dist/server/security/index.js"
    },
    "./server/storage": {
      "types": "./dist/server/storage/index.d.ts",
      "import": "./dist/server/storage/index.js"
    },
    "./server/webhook": {
      "types": "./dist/server/webhook/index.d.ts",
      "import": "./dist/server/webhook/index.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin/index.d.ts",
      "import": "./dist/vite-plugin/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/core": {
      "types": "./dist/client/core.d.ts",
      "import": "./dist/client/core.js"
    },
    "./react-query": {
      "types": "./dist/react-query/index.d.ts",
      "import": "./dist/react-query/index.js"
    },
    "./adapters/security-headers": {
      "types": "./dist/adapters/security-headers.d.ts",
      "import": "./dist/adapters/security-headers.js"
    },
    "./router/element-scroll-restoration": {
      "types": "./dist/router/element-scroll-restoration.d.ts",
      "import": "./dist/router/element-scroll-restoration.js"
    },
    "./adapters/agent-mount": {
      "types": "./dist/adapters/agent-mount.d.ts",
      "import": "./dist/adapters/agent-mount.js"
    },
    "./adapters/web-shim": {
      "types": "./dist/adapters/web-shim.d.ts",
      "import": "./dist/adapters/web-shim.js"
    },
    "./adapters/ws-shim": {
      "types": "./dist/adapters/ws-shim.d.ts",
      "import": "./dist/adapters/ws-shim.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@theokit/agents": "workspace:^",
    "@theokit/http": "workspace:^",
    "@theokit/presenter": "workspace:^",
    "@vitejs/plugin-react": "^4.7.0",
    "busboy": "^1.6.0",
    "cac": "^6.7.14",
    "cron-parser": "^5.5.0",
    "devalue": "^5.8.1",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^11.0.7",
    "goober": "^2.1.19",
    "picomatch": "^4.0.4",
    "reflect-metadata": "^0.2.2",
    "superjson": "^2.2.6",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  },
  "peerDependencies": {
    "@theokit/sdk": "^5.0.0",
    "@theokit/ui": "^1.1.0",
    "db0": "^0.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0 || ^8.0.0",
    "unstorage": "^1.10.0",
    "ws": "^8.20.1",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@theokit/sdk": {
      "optional": true
    },
    "@theokit/ui": {
      "optional": true
    },
    "db0": {
      "optional": true
    },
    "unstorage": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@theokit/sdk": "^5.0.0",
    "@types/busboy": "^1.5.4",
    "@types/picomatch": "^4.0.3",
    "better-sqlite3": "^12.11.1",
    "db0": "^0.3.4",
    "unstorage": "^1.17.5"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "theokit",
    "web",
    "framework",
    "file-based",
    "routing",
    "typed",
    "server",
    "surfaces"
  ]
}
